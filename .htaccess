<IfModule mod_rewrite.c>
  RewriteEngine On

  # If request is for an existing file or directory, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise rewrite everything to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Optional: serve gzip/brotli if generated (adjust if you generated compressed assets)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|html|svg)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>

